    </Properties>
    <Item class="Script" referent="2">
      <Properties>
        <string name="Name">ArenaBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

-- Brainrot Heroes Raid Arena
-- Builds a reusable, original raid room without external or copyrighted assets.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ARENA_NAME = "BrainrotHeroesRaidArena"
local ORIGIN = Vector3.new(0, 0, 0)
local ARENA_RADIUS = 112

local COLORS = {
	void = Color3.fromRGB(18, 21, 48),
	stone = Color3.fromRGB(52, 58, 93),
	stoneLight = Color3.fromRGB(80, 87, 128),
	cyan = Color3.fromRGB(45, 235, 255),
	purple = Color3.fromRGB(170, 67, 255),
	pink = Color3.fromRGB(255, 68, 184),
	gold = Color3.fromRGB(255, 204, 76),
	white = Color3.fromRGB(239, 249, 255),
}

local HERO_PROFILES = {
	{ name = "Turbo Tasso", rarity = "EPICO", power = "Scatto Fulmineo", damage = 520, kind = "Damage", description = "Carica il boss e lascia una scia elettrica che potenzia gli alleati." },
	{ name = "Gatto Galattico", rarity = "MITICO", power = "Zampa Cosmica", damage = 640, kind = "Damage", description = "Apre una mini galassia che rallenta il mostro e moltiplica i frammenti." },
	{ name = "Cocco Drago", rarity = "LEGGENDARIO", power = "Fiamma Tropicale", damage = 820, kind = "Damage", description = "Sputa un vortice caldo che rompe lo scudo del Brainrot Hero." },
	{ name = "Panda Plasma", rarity = "EPICO", power = "Abbraccio Ionico", damage = 220, kind = "Shield", description = "Protegge la squadra con una barriera al plasma color ciano." },
	{ name = "Gorilla Gelato", rarity = "MITICO", power = "Pugno Granita", damage = 610, kind = "Freeze", description = "Congela il terreno e blocca gli attacchi più forti del boss." },
	{ name = "Volpe Vortex", rarity = "LEGGENDARIO", power = "Coda Tornado", damage = 760, kind = "Damage", description = "Crea un vortice viola che trascina i frammenti verso la squadra." },
	{ name = "Axolotl Astro", rarity = "EPICO", power = "Bolla Stellare", damage = 180, kind = "Heal", description = "Cura gli Heroes vicini e rianima un alleato durante il raid." },
	{ name = "Robot Raviolo", rarity = "SEGRETO", power = "Salsa Suprema", damage = 1000, kind = "Damage", description = "Attiva una modalità segreta che aumenta temporaneamente tutti i danni." },
}

if workspace:FindFirstChild(ARENA_NAME) then
	workspace[ARENA_NAME]:Destroy()
end

local arena = Instance.new("Model")
arena.Name = ARENA_NAME
arena:SetAttribute("ReadyForRaidLogic", true)
arena:SetAttribute("RecommendedMaxRaiders", 50)
arena:SetAttribute("RaidState", "COUNTDOWN")
arena:SetAttribute("Countdown", 25)
arena.Parent = workspace

local oldRemotes = ReplicatedStorage:FindFirstChild("BrainrotHeroesRemotes")
if oldRemotes then
	oldRemotes:Destroy()
end
local remotes = Instance.new("Folder")
remotes.Name = "BrainrotHeroesRemotes"
remotes.Parent = ReplicatedStorage
local useHeroPower = Instance.new("RemoteEvent")
useHeroPower.Name = "UseHeroPower"
useHeroPower.Parent = remotes

local geometry = Instance.new("Folder")
geometry.Name = "Architecture"
geometry.Parent = arena

local effects = Instance.new("Folder")
effects.Name = "Effects"
effects.Parent = arena

local gameplay = Instance.new("Folder")
gameplay.Name = "GameplayMarkers"
gameplay.Parent = arena
local bossDamaged = Instance.new("BindableEvent")
bossDamaged.Name = "BossDamaged"
bossDamaged.Parent = gameplay

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	transparency: number?,
	shape: Enum.PartType?
): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Anchored = true
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material
	object.Transparency = transparency or 0
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CastShadow = material ~= Enum.Material.Neon
	if shape then
		object.Shape = shape
	end
	object.Parent = parent
	return object
end

local function cylinder(
	parent: Instance,
	name: string,
	diameter: number,
	height: number,
	y: number,
	color: Color3,
	material: Enum.Material,
	transparency: number?
): Part
	return part(
		parent,
		name,
		Vector3.new(height, diameter, diameter),
		CFrame.new(ORIGIN + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		transparency,
		Enum.PartType.Cylinder
	)
end

local function ring(
	parent: Instance,
	name: string,
	radius: number,
	width: number,
	height: number,
	y: number,
	color: Color3,
	material: Enum.Material,
	segments: number,
	transparency: number?
)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	local segmentLength = (2 * math.pi * radius / segments) * 1.04
	for index = 1, segments do
		local angle = ((index - 1) / segments) * math.pi * 2
		local position = ORIGIN + Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
		part(
			folder,
			string.format("Segment%02d", index),
			Vector3.new(segmentLength, height, width),
			CFrame.new(position) * CFrame.Angles(0, -angle, 0),
			color,
			material,
			transparency
		)
	end
	return folder
end

local function addPointLight(parent: Instance, color: Color3, brightness: number, range: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = parent
	return light
end

local function addBillboard(parent: BasePart, title: string, subtitle: string, color: Color3)
	local isHeroLabel = string.sub(title, 1, 4) == "HERO"
	local gui = Instance.new("BillboardGui")
	gui.Name = "HologramLabel"
	gui.Size = if isHeroLabel then UDim2.fromOffset(230, 62) else UDim2.fromOffset(390, 104)
	gui.StudsOffsetWorldSpace = if isHeroLabel then Vector3.new(0, 4.5, 0) else Vector3.new(0, 4.2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = if isHeroLabel then 52 else 145
	gui.LightInfluence = 0.1
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = COLORS.void
	frame.BackgroundTransparency = if isHeroLabel then 0.32 else 0.22
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 22)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = if isHeroLabel then 2 else 3
	stroke.Transparency = 0.22
	stroke.Parent = frame

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(0.5, COLORS.white),
		ColorSequenceKeypoint.new(1, COLORS.purple),
	})
	gradient.Rotation = 10
	gradient.Parent = stroke

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.fromScale(0.04, 0.08)
	titleLabel.Size = UDim2.fromScale(0.92, if isHeroLabel then 0.42 else 0.48)
	titleLabel.Font = Enum.Font.GothamBlack
	titleLabel.Text = title
	titleLabel.TextColor3 = COLORS.white
	titleLabel.TextScaled = true
	titleLabel.Parent = frame

	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Position = UDim2.fromScale(0.04, if isHeroLabel then 0.54 else 0.57)
	subtitleLabel.Size = UDim2.fromScale(0.92, if isHeroLabel then 0.24 else 0.28)
	subtitleLabel.Font = Enum.Font.GothamBold
	subtitleLabel.Text = subtitle
	subtitleLabel.TextColor3 = color
	subtitleLabel.TextScaled = true
	subtitleLabel.Parent = frame

	return subtitleLabel
end

local function createHeroAltar(index: number, angle: number)
	local profile = HERO_PROFILES[index]
	local radius = 76
	local position = ORIGIN + Vector3.new(math.cos(angle) * radius, 4.2, math.sin(angle) * radius)
	local altar = Instance.new("Model")
	altar.Name = string.format("HeroAltar%02d", index)
	altar:SetAttribute("HeroSlot", index)
	altar:SetAttribute("Occupied", false)
	altar:SetAttribute("HeroName", profile.name)
	altar:SetAttribute("Rarity", profile.rarity)
	altar:SetAttribute("Power", profile.power)
	altar.Parent = geometry

	local base = part(
		altar,
		"Base",
		Vector3.new(2.5, 15, 15),
		CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		COLORS.stoneLight,
		Enum.Material.Slate,
		0,
		Enum.PartType.Cylinder
	)
	local accentColor = if index % 2 == 0 then COLORS.cyan else COLORS.purple
	local glow = part(
		altar,
		"HeroGlow",
		Vector3.new(0.45, 11.5, 11.5),
		base.CFrame + Vector3.new(0, 1.5, 0),
		accentColor,
		Enum.Material.Neon,
		0.08,
		Enum.PartType.Cylinder
	)
	glow.CanCollide = false
	addPointLight(glow, accentColor, 1.5, 18)

	local crystal = part(
		altar,
		"HeroCrystal",
		Vector3.new(3.8, 9, 3.8),
		CFrame.new(position + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, angle, math.rad(45)),
		accentColor,
		Enum.Material.Glass,
		0.18
	)
	crystal.CanCollide = false
	local inspectPrompt = Instance.new("ProximityPrompt")
	inspectPrompt.Name = "InspectHero"
	inspectPrompt.ActionText = "Scopri Hero"
	inspectPrompt.ObjectText = string.format("%s • %s", profile.name, profile.rarity)
	inspectPrompt.KeyboardKeyCode = Enum.KeyCode.E
	inspectPrompt.HoldDuration = 0.15
	inspectPrompt.MaxActivationDistance = 11
	inspectPrompt.RequiresLineOfSight = false
	inspectPrompt:SetAttribute("HeroName", profile.name)
	inspectPrompt:SetAttribute("Rarity", profile.rarity)
	inspectPrompt:SetAttribute("Power", profile.power)
	inspectPrompt:SetAttribute("Description", profile.description)
	inspectPrompt:SetAttribute("Accent", if index % 2 == 0 then "Cyan" else "Purple")
	inspectPrompt:SetAttribute("SlotIndex", index)
	inspectPrompt.Parent = crystal

	local marker = part(
		gameplay,
		string.format("HeroSlot%02d", index),
		Vector3.new(8, 0.4, 8),
		CFrame.new(position + Vector3.new(0, 2.8, 0)),
		accentColor,
		Enum.Material.Neon,
		0.88
	)
	marker.CanCollide = false
	marker:SetAttribute("SlotIndex", index)

	return glow, crystal
end

local function createPillar(index: number, angle: number)
	local radius = 101
	local position = ORIGIN + Vector3.new(math.cos(angle) * radius, 18, math.sin(angle) * radius)
	local pillar = Instance.new("Model")
	pillar.Name = string.format("Pillar%02d", index)
	pillar.Parent = geometry

	part(pillar, "Column", Vector3.new(7, 36, 7), CFrame.new(position), COLORS.stone, Enum.Material.Slate)
	part(
		pillar,
		"LightChannel",
		Vector3.new(7.35, 18, 0.35),
		CFrame.new(position) * CFrame.Angles(0, -angle, 0),
		if index % 2 == 0 then COLORS.cyan else COLORS.purple,
		Enum.Material.Neon,
		0.08
	).CanCollide = false
	part(
		pillar,
		"Crown",
		Vector3.new(9, 3, 9),
		CFrame.new(position + Vector3.new(0, 19, 0)),
		COLORS.stoneLight,
		Enum.Material.Metal
	)
end

local function createPortal()
	local portalModel = Instance.new("Model")
	portalModel.Name = "BossPortal"
	portalModel.Parent = geometry

	local portalCenter = ORIGIN + Vector3.new(0, 25, -95)
	part(
		portalModel,
		"LeftTower",
		Vector3.new(12, 52, 15),
		CFrame.new(portalCenter + Vector3.new(-22, 0, 0)),
		COLORS.stone,
		Enum.Material.Slate
	)
	part(
		portalModel,
		"RightTower",
		Vector3.new(12, 52, 15),
		CFrame.new(portalCenter + Vector3.new(22, 0, 0)),
		COLORS.stone,
		Enum.Material.Slate
	)
	part(
		portalModel,
		"Crown",
		Vector3.new(56, 9, 18),
		CFrame.new(portalCenter + Vector3.new(0, 29, 0)),
		COLORS.stoneLight,
		Enum.Material.Metal
	)

	local portal = part(
		portalModel,
		"Rift",
		Vector3.new(2.2, 42, 42),
		CFrame.new(portalCenter) * CFrame.Angles(0, math.rad(90), 0),
		COLORS.purple,
		Enum.Material.Neon,
		0.28,
		Enum.PartType.Cylinder
	)
	portal.CanCollide = false
	addPointLight(portal, COLORS.purple, 5, 70)

	local inner = part(
		portalModel,
		"RiftCore",
		Vector3.new(2.5, 31, 31),
		portal.CFrame + Vector3.new(0, 0, 0.4),
		COLORS.void,
		Enum.Material.Glass,
		0.08,
		Enum.PartType.Cylinder
	)
	inner.CanCollide = false

	for index = 1, 12 do
		local angle = (index / 12) * math.pi * 2
		local shardPosition = portalCenter
			+ Vector3.new(math.cos(angle) * 26, math.sin(angle) * 26, -1.5)
		local shard = part(
			portalModel,
			string.format("Rune%02d", index),
			Vector3.new(2.2, 5.5, 2.2),
			CFrame.new(shardPosition) * CFrame.Angles(angle, 0, math.rad(45)),
			if index % 2 == 0 then COLORS.cyan else COLORS.pink,
			Enum.Material.Neon,
			0.05
		)
		shard.CanCollide = false
	end

	local particles = Instance.new("ParticleEmitter")
	particles.Name = "RiftParticles"
	particles.Color = ColorSequence.new(COLORS.purple, COLORS.cyan)
	particles.LightEmission = 1
	particles.Rate = 22
	particles.Lifetime = NumberRange.new(1.5, 3.2)
	particles.Speed = NumberRange.new(1, 4)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Rotation = NumberRange.new(0, 360)
	particles.RotSpeed = NumberRange.new(-90, 90)
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.5, 0.25),
		NumberSequenceKeypoint.new(1, 0),
	})
	particles.Parent = portal

	return portal
end

local function createBoss()
	local boss = Instance.new("Model")
	boss.Name = "PrismaRex"
	boss:SetAttribute("DisplayName", "Prisma Rex")
	boss:SetAttribute("BossType", "BrainrotHero")
	boss:SetAttribute("RewardRule", "One full Hero, fragments for all other eligible raiders")
	boss:SetAttribute("MaxHealth", 10000)
	boss:SetAttribute("Health", 10000)
	boss.Parent = arena

	-- The boss owns the central platform; the countdown crystal sits to its left.
	local center = ORIGIN + Vector3.new(0, 5.2, 0)
	local bossPurple = Color3.fromRGB(105, 42, 204)
	local bossPink = Color3.fromRGB(255, 75, 190)
	local bossCyan = Color3.fromRGB(53, 239, 255)
	local bossGold = Color3.fromRGB(255, 211, 75)

	local torso = part(
		boss,
		"Torso",
		Vector3.new(18, 20, 11),
		CFrame.new(center + Vector3.new(0, 20, 0)),
		bossPurple,
		Enum.Material.SmoothPlastic
	)
	boss.PrimaryPart = torso

	for _, side in { -1, 1 } do
		part(
			boss,
			if side < 0 then "LeftLeg" else "RightLeg",
			Vector3.new(6, 13, 7),
			CFrame.new(center + Vector3.new(side * 5, 8, 0)),
			COLORS.stone,
			Enum.Material.Metal
		)
		part(
			boss,
			if side < 0 then "LeftBoot" else "RightBoot",
			Vector3.new(7.5, 4.5, 10),
			CFrame.new(center + Vector3.new(side * 5, 2.6, 1.3)),
			COLORS.void,
			Enum.Material.Metal
		)
		part(
			boss,
			if side < 0 then "LeftArm" else "RightArm",
			Vector3.new(5.5, 19, 5.5),
			CFrame.new(center + Vector3.new(side * 13, 18, 0)) * CFrame.Angles(0, 0, math.rad(side * -8)),
			bossPurple,
			Enum.Material.SmoothPlastic
		)
		part(
			boss,
			if side < 0 then "LeftShoulder" else "RightShoulder",
			Vector3.new(9, 9, 9),
			CFrame.new(center + Vector3.new(side * 12, 27, 0)),
			bossPink,
			Enum.Material.Glass,
			0.08,
			Enum.PartType.Ball
		)
		local hand = part(
			boss,
			if side < 0 then "LeftPowerFist" else "RightPowerFist",
			Vector3.new(7, 7, 7),
			CFrame.new(center + Vector3.new(side * 14.2, 8.2, 0.8)),
			bossCyan,
			Enum.Material.Neon,
			0.08,
			Enum.PartType.Ball
		)
		addPointLight(hand, bossCyan, 1.5, 20)
	end

	local head = part(
		boss,
		"Head",
		Vector3.new(16, 16, 16),
		CFrame.new(center + Vector3.new(0, 37, 0)),
		bossPink,
		Enum.Material.SmoothPlastic,
		0,
		Enum.PartType.Ball
	)

	for _, eyeX in { -3.2, 3.2 } do
		part(
			boss,
			"EyeWhite",
			Vector3.new(4.5, 5.2, 2.1),
			CFrame.new(center + Vector3.new(eyeX, 39, 7.1)),
			COLORS.white,
			Enum.Material.SmoothPlastic,
			0,
			Enum.PartType.Ball
		).CanCollide = false
		part(
			boss,
			"EyeGlow",
			Vector3.new(1.9, 2.5, 1),
			CFrame.new(center + Vector3.new(eyeX, 39, 8.2)),
			bossCyan,
			Enum.Material.Neon,
			0,
			Enum.PartType.Ball
		).CanCollide = false
	end

	part(
		boss,
		"Mouth",
		Vector3.new(7.5, 2.1, 1),
		CFrame.new(center + Vector3.new(0, 33.8, 7.2)),
		COLORS.void,
		Enum.Material.SmoothPlastic
	).CanCollide = false
	for toothIndex = -2, 2 do
		part(
			boss,
			"Tooth",
			Vector3.new(0.8, 1.15, 0.45),
			CFrame.new(center + Vector3.new(toothIndex * 1.25, 34.15, 7.75)),
			COLORS.white,
			Enum.Material.SmoothPlastic
		).CanCollide = false
	end

	for spikeIndex = -2, 2 do
		local spikeHeight = 7.5 - math.abs(spikeIndex) * 1.1
		part(
			boss,
			"CrownSpike",
			Vector3.new(2.3, spikeHeight, 2.3),
			CFrame.new(center + Vector3.new(spikeIndex * 3.1, 47 + spikeHeight * 0.25, 0))
				* CFrame.Angles(0, 0, math.rad(spikeIndex * -8)),
			bossGold,
			Enum.Material.Neon,
			0.04
		).CanCollide = false
	end

	local core = part(
		boss,
		"HeroCore",
		Vector3.new(8, 8, 4),
		CFrame.new(center + Vector3.new(0, 21, 6)),
		bossCyan,
		Enum.Material.Glass,
		0.08,
		Enum.PartType.Ball
	)
	core.CanCollide = false
	addPointLight(core, bossCyan, 3, 34)

	local shield = part(
		boss,
		"CountdownShield",
		Vector3.new(42, 50, 42),
		CFrame.new(center + Vector3.new(0, 23, 0)),
		bossCyan,
		Enum.Material.ForceField,
		0.9,
		Enum.PartType.Ball
	)
	shield.CanCollide = false
	shield:SetAttribute("DisableWhenRaidStarts", true)

	local nameGui = Instance.new("BillboardGui")
	nameGui.Name = "BossName"
	nameGui.Size = UDim2.fromOffset(260, 44)
	nameGui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	nameGui.AlwaysOnTop = false
	nameGui.MaxDistance = 260
	nameGui.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundColor3 = COLORS.void
	nameLabel.BackgroundTransparency = 0.18
	nameLabel.BorderSizePixel = 0
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.Text = "PRISMA REX • HERO BOSS"
	nameLabel.TextColor3 = bossGold
	nameLabel.TextScaled = true
	nameLabel.Parent = nameGui
	local nameCorner = Instance.new("UICorner")
	nameCorner.CornerRadius = UDim.new(0, 18)
	nameCorner.Parent = nameLabel
	local nameStroke = Instance.new("UIStroke")
	nameStroke.Color = bossPink
	nameStroke.Thickness = 3
	nameStroke.Parent = nameLabel

	return boss, core, nameLabel
end

-- Layered arena floor and safe combat boundary.
cylinder(geometry, "Foundation", ARENA_RADIUS * 2, 8, -4, COLORS.void, Enum.Material.Basalt)
cylinder(geometry, "MainFloor", 205, 1.6, 0.3, COLORS.stone, Enum.Material.Slate)
cylinder(geometry, "InnerFloor", 128, 0.5, 1.25, COLORS.stoneLight, Enum.Material.Metal)
ring(geometry, "OuterGoldTrim", 104, 3.2, 1.1, 1.25, COLORS.gold, Enum.Material.Neon, 64, 0.22)
ring(geometry, "EnergyCircuitA", 87, 1.25, 0.25, 1.45, COLORS.cyan, Enum.Material.Neon, 48, 0.3)
ring(geometry, "EnergyCircuitB", 61, 1.5, 0.25, 1.58, COLORS.purple, Enum.Material.Neon, 40, 0.28)
ring(geometry, "CentralHalo", 31, 2.4, 0.35, 2.05, COLORS.pink, Enum.Material.Neon, 32, 0.22)

-- Radial luminous paths keep the room readable during a crowded raid.
for index = 1, 8 do
	local angle = ((index - 1) / 8) * math.pi * 2
	local pathCenter = ORIGIN + Vector3.new(math.cos(angle) * 45, 1.58, math.sin(angle) * 45)
	part(
		geometry,
		string.format("EnergyPath%02d", index),
		Vector3.new(72, 0.22, 1.2),
		CFrame.new(pathCenter) * CFrame.Angles(0, -angle, 0),
		if index % 2 == 0 then COLORS.cyan else COLORS.purple,
		Enum.Material.Neon,
		0.46
	).CanCollide = false
end

-- Walls and tall rhythm pillars create a dramatic silhouette.
ring(geometry, "ArenaWall", 110, 5.5, 18, 9, COLORS.stone, Enum.Material.Slate, 64, 0)
for index = 1, 12 do
	createPillar(index, ((index - 1) / 12) * math.pi * 2)
end

-- Elevated arena lights reveal the architecture while preserving the neon palette.
for index = 1, 8 do
	local angle = ((index - 1) / 8) * math.pi * 2 + math.rad(22.5)
	local lampPosition = ORIGIN + Vector3.new(math.cos(angle) * 84, 31, math.sin(angle) * 84)
	local lampColor = if index % 2 == 0 then Color3.fromRGB(210, 235, 255) else Color3.fromRGB(255, 226, 185)
	local lamp = part(
		effects,
		string.format("ArenaLamp%02d", index),
		Vector3.new(4.5, 4.5, 4.5),
		CFrame.new(lampPosition),
		lampColor,
		Enum.Material.Neon,
		0.08,
		Enum.PartType.Ball
	)
	lamp.CanCollide = false
	addPointLight(lamp, lampColor, 2.6, 60)
end

-- Eight large hero displays; raid/player markers remain configurable up to 50.
local animatedGlows = {}
local floatingCrystals = {}
for index = 1, 8 do
	local glow, crystal = createHeroAltar(index, ((index - 1) / 8) * math.pi * 2 + math.rad(22.5))
	table.insert(animatedGlows, glow)
	table.insert(floatingCrystals, crystal)
end

-- Central raid core and holographic countdown.
local coreBase = cylinder(geometry, "RaidCoreBase", 42, 4, 3.2, COLORS.void, Enum.Material.Metal)
local coreGlow = cylinder(effects, "RaidCoreGlow", 32, 0.8, 5.6, COLORS.cyan, Enum.Material.Neon, 0.5)
coreGlow.CanCollide = false
addPointLight(coreGlow, COLORS.cyan, 3.2, 50)

local coreCrystal = part(
	effects,
	"CountdownCrystal",
	Vector3.new(7, 14, 7),
	CFrame.new(ORIGIN + Vector3.new(-34, 14, -4)) * CFrame.Angles(0, math.rad(45), math.rad(45)),
	COLORS.white,
	Enum.Material.Glass,
	0.15
)
coreCrystal.CanCollide = false
local countdownLabel = addBillboard(coreCrystal, "MEGA RAID", "EVENTO IN PREPARAZIONE", COLORS.gold)

local raidSpawn = part(
	gameplay,
	"RaidBossSpawn",
	Vector3.new(18, 0.5, 18),
	CFrame.new(ORIGIN + Vector3.new(0, 5.5, 0)),
	COLORS.pink,
	Enum.Material.Neon,
	0.9
)
raidSpawn.CanCollide = false
raidSpawn:SetAttribute("Purpose", "Spawn the original Brainrot Hero boss here")

local playerSpawn = Instance.new("SpawnLocation")
playerSpawn.Name = "PlayerSpawn"
playerSpawn.Anchored = true
playerSpawn.CanCollide = true
playerSpawn.Neutral = true
playerSpawn.Size = Vector3.new(14, 1, 14)
playerSpawn.CFrame = CFrame.new(ORIGIN + Vector3.new(0, 2.2, 58))
playerSpawn.Material = Enum.Material.SmoothPlastic
playerSpawn.Color = COLORS.stone
playerSpawn.Transparency = 1
playerSpawn.Duration = 0
playerSpawn.Parent = gameplay

local portal = createPortal()
local boss, bossCore, bossNameLabel = createBoss()
local bossBasePivot = boss:GetPivot()

local powerCooldowns: { [Player]: number } = {}

local function updateBossLabel()
	local health = boss:GetAttribute("Health") :: number
	local maxHealth = boss:GetAttribute("MaxHealth") :: number
	local percent = math.max(0, math.ceil((health / maxHealth) * 100))
	bossNameLabel.Text = string.format("PRISMA REX • %d%%", percent)
end

local function resetBoss()
	boss:SetAttribute("Health", boss:GetAttribute("MaxHealth"))
	boss:SetAttribute("Defeated", false)
	bossCore.Color = COLORS.cyan
	updateBossLabel()
end

local function showPowerImpact(originPosition: Vector3, damage: number, powerName: string)
	local projectile = part(
		effects,
		"HeroPowerProjectile",
		Vector3.new(3.5, 3.5, 3.5),
		CFrame.new(originPosition),
		COLORS.cyan,
		Enum.Material.Neon,
		0.06,
		Enum.PartType.Ball
	)
	projectile.CanCollide = false
	addPointLight(projectile, COLORS.cyan, 2.5, 22)
	local travel = TweenService:Create(projectile, TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = CFrame.new(bossCore.Position),
		Size = Vector3.new(6, 6, 6),
		Color = COLORS.gold,
	})
	travel:Play()
	travel.Completed:Once(function()
		if projectile.Parent then
			projectile:Destroy()
		end

		local impact = part(
			effects,
			"PowerImpact",
			Vector3.new(5, 5, 5),
			CFrame.new(bossCore.Position),
			COLORS.gold,
			Enum.Material.Neon,
			0.12,
			Enum.PartType.Ball
		)
		impact.CanCollide = false
		local impactGui = Instance.new("BillboardGui")
		impactGui.Size = UDim2.fromOffset(280, 92)
		impactGui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
		impactGui.AlwaysOnTop = true
		impactGui.Parent = impact
		local impactText = Instance.new("TextLabel")
		impactText.BackgroundTransparency = 1
		impactText.Size = UDim2.fromScale(1, 1)
		impactText.Font = Enum.Font.GothamBlack
		impactText.Text = string.format("-%d\n%s", damage, string.upper(powerName))
		impactText.TextColor3 = COLORS.gold
		impactText.TextStrokeColor3 = COLORS.void
		impactText.TextStrokeTransparency = 0
		impactText.TextScaled = true
		impactText.Parent = impactGui
		TweenService:Create(impact, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = impact.CFrame + Vector3.new(0, 10, 0),
			Size = Vector3.new(15, 15, 15),
			Transparency = 1,
		}):Play()
		TweenService:Create(impactText, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.75, function()
			if impact.Parent then
				impact:Destroy()
			end
		end)
	end)
end

useHeroPower.OnServerEvent:Connect(function(player: Player, slotIndex: number)
	if type(slotIndex) ~= "number" or slotIndex % 1 ~= 0 then
		return
	end
	local profile = HERO_PROFILES[slotIndex]
	if not profile then
		return
	end

	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") or (root.Position - ORIGIN).Magnitude > 145 then
		useHeroPower:FireClient(player, false, "Avvicinati all'arena per usare il potere.")
		return
	end

	local now = os.clock()
	local readyAt = powerCooldowns[player] or 0
	if now < readyAt then
		useHeroPower:FireClient(player, false, string.format("Potere in ricarica: %.1fs", readyAt - now))
		return
	end
	if boss:GetAttribute("Defeated") then
		useHeroPower:FireClient(player, false, "Prisma Rex è già stato sconfitto!")
		return
	end
	if arena:GetAttribute("RaidState") ~= "ACTIVE" then
		useHeroPower:FireClient(player, false, "Il raid non è ancora iniziato!")
		return
	end
	powerCooldowns[player] = now + 6

	if profile.kind == "Shield" and character then
		local forceField = Instance.new("ForceField")
		forceField.Visible = true
		forceField.Parent = character
		task.delay(5, function()
			if forceField.Parent then
				forceField:Destroy()
			end
		end)
	elseif profile.kind == "Heal" and character then
		local humanoid = character:FindFirstChildWhichIsA("Humanoid")
		if humanoid then
			humanoid.Health = humanoid.MaxHealth
		end
	elseif profile.kind == "Freeze" then
		boss:SetAttribute("FrozenUntil", os.clock() + 3)
	end

	local currentHealth = boss:GetAttribute("Health") :: number
	local newHealth = math.max(0, currentHealth - profile.damage)
	showPowerImpact(root.Position + Vector3.new(0, 3, 0), profile.damage, profile.power)
	boss:SetAttribute("Health", newHealth)
	bossDamaged:Fire(player, profile.damage, profile.power)
	updateBossLabel()
	bossCore.Color = COLORS.white
	task.delay(0.18, function()
		if bossCore.Parent then
			bossCore.Color = COLORS.cyan
		end
	end)
	useHeroPower:FireClient(player, true, string.format("COLPO! -%d", profile.damage))

	if newHealth <= 0 then
		boss:SetAttribute("Defeated", true)
		bossNameLabel.Text = "PRISMA REX SCONFITTO!"
		bossCore.Color = COLORS.gold
	end
end)

-- Original cosmic lighting; no external images or audio are required.
Lighting.Brightness = 3.0
Lighting.ExposureCompensation = 0.52
Lighting.Ambient = Color3.fromRGB(96, 94, 127)
Lighting.OutdoorAmbient = Color3.fromRGB(68, 78, 110)
Lighting.ColorShift_Top = Color3.fromRGB(46, 34, 78)
Lighting.FogColor = Color3.fromRGB(29, 31, 65)
Lighting.FogStart = 240
Lighting.FogEnd = 680

for _, effectName in { "BrainrotArenaBloom", "BrainrotArenaColor", "BrainrotArenaAtmosphere" } do
	local old = Lighting:FindFirstChild(effectName)
	if old then
		old:Destroy()
	end
end

local bloom = Instance.new("BloomEffect")
bloom.Name = "BrainrotArenaBloom"
bloom.Intensity = 0.48
bloom.Size = 24
bloom.Threshold = 1.45
bloom.Parent = Lighting

local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "BrainrotArenaColor"
colorCorrection.Brightness = 0.05
colorCorrection.Contrast = 0.06
colorCorrection.Saturation = 0.08
colorCorrection.TintColor = Color3.fromRGB(239, 242, 255)
colorCorrection.Parent = Lighting

local atmosphere = Instance.new("Atmosphere")
atmosphere.Name = "BrainrotArenaAtmosphere"
atmosphere.Color = Color3.fromRGB(91, 78, 156)
atmosphere.Decay = Color3.fromRGB(17, 11, 38)
atmosphere.Density = 0.08
atmosphere.Glare = 0.2
atmosphere.Haze = 0.65
atmosphere.Parent = Lighting

-- Slow, low-cost ambient motion. It gives the room life without flooding mobile devices.
task.spawn(function()
	local pulseInfo = TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(portal, pulseInfo, { Transparency = 0.5, Color = COLORS.pink }):Play()
	TweenService:Create(bossCore, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.35,
		Color = COLORS.gold,
	}):Play()
	TweenService:Create(coreGlow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.68,
		Color = COLORS.purple,
	}):Play()
	for index, glow in animatedGlows do
		local target = if index % 2 == 0 then COLORS.purple else COLORS.cyan
		TweenService:Create(glow, TweenInfo.new(2 + index * 0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Transparency = 0.32,
			Color = target,
		}):Play()
	end

	local elapsed = 0
	while arena.Parent do
		local delta = task.wait(0.05)
		elapsed += delta
		coreCrystal.CFrame = CFrame.new(ORIGIN + Vector3.new(-34, 14 + math.sin(elapsed * 1.2) * 1.2, -4))
			* CFrame.Angles(elapsed * 0.35, elapsed * 0.55, math.rad(45))
		boss:PivotTo(bossBasePivot * CFrame.new(0, math.sin(elapsed * 0.85) * 0.75, 0) * CFrame.Angles(0, math.sin(elapsed * 0.42) * 0.035, 0))
		for index, crystal in floatingCrystals do
			crystal.CFrame *= CFrame.Angles(0, 0.012 + index * 0.0005, 0)
		end
	end
end)

-- Preview text is only used if the full raid controller is not present.
task.spawn(function()
	local previewMessages = {
		"EVENTO IN PREPARAZIONE",
		"1 HERO COMPLETO • FRAMMENTI PER TUTTI",
		"COMBATTI PER ENTRARE NELL'ESTRAZIONE",
	}
	local index = 1
	while arena.Parent do
		if not arena:GetAttribute("RaidControllerActive") then
			countdownLabel.Text = previewMessages[index]
			index = (index % #previewMessages) + 1
		end
		task.wait(4.5)
	end
end)

arena.PrimaryPart = coreBase
print("Brainrot Heroes Raid Arena ready")
]]></string>
