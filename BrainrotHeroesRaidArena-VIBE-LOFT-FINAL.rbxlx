local weaponStations = {
	{ name = "NOVA PULSE", tool = "Nova Pulse", color = COLORS.cyan, shape = "BLASTER" },
	{ name = "PRISM FANG", tool = "Prism Fang", color = COLORS.purple, shape = "BLADE" },
	{ name = "STARBREAKER X", tool = "Starbreaker X", color = COLORS.pink, shape = "ROCKET" },
}
for index, data in weaponStations do
	local x = (index - 2) * 6
	local stationColor = data.color :: Color3
	local pedestal = part(gameplay, "WeaponPedestal", Vector3.new(2, 3.5, 2), CFrame.new(LOFT_ORIGIN + Vector3.new(x, 2.55, 35)), stationColor, Enum.Material.Neon, 0.08)
	light(pedestal, stationColor, 5, 16)
	local display: Part
	if data.shape == "BLADE" then
		display = part(gameplay, "WeaponDisplay", Vector3.new(0.65, 7, 1.4), pedestal.CFrame * CFrame.new(0, 5.1, 0) * CFrame.Angles(0, 0, math.rad(-12)), stationColor, Enum.Material.Neon)
	elseif data.shape == "ROCKET" then
		display = part(gameplay, "WeaponDisplay", Vector3.new(2.8, 2.8, 6.5), pedestal.CFrame * CFrame.new(0, 4.8, 0) * CFrame.Angles(0, math.rad(90), math.rad(-8)), stationColor, Enum.Material.Neon)
	else
		display = part(gameplay, "WeaponDisplay", Vector3.new(3.4, 2.5, 5.5), pedestal.CFrame * CFrame.new(0, 4.8, 0) * CFrame.Angles(0, math.rad(90), 0), stationColor, Enum.Material.Neon)
	end
	display.CanCollide = false
	billboard(display, data.name :: string, "TOCCA • EQUIPAGGIA", stationColor, 190)
	local equipPrompt = Instance.new("ProximityPrompt")
	equipPrompt.ActionText = "EQUIPAGGIA"
	equipPrompt.ObjectText = data.name :: string
	equipPrompt.HoldDuration = 0
	equipPrompt.MaxActivationDistance = 8
	equipPrompt.RequiresLineOfSight = false
	equipPrompt.Parent = pedestal
	equipPrompt.Triggered:Connect(function(player)
		local backpack = player:FindFirstChildOfClass("Backpack")
		local character = player.Character
		local humanoid = if character then character:FindFirstChildWhichIsA("Humanoid") else nil
		local tool = if backpack then backpack:FindFirstChild(data.tool :: string) else nil
		if humanoid and tool and tool:IsA("Tool") then
			humanoid:EquipTool(tool)
		end
	end)
end

